\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Error taxonomy of the oracle gap. Each cell is \emph  {prevalence}\,/\,\emph  {share of total gap mass}. Full RefCOCO validation split, 10{,}834 expressions, oracle mIoU 0.8221 in both columns. Under-seg.\ = under-segmentation; over-seg.\ = over-segmentation.}}{3}{table.1}\protected@file@percent }
\newlabel{tab:taxonomy}{{I}{3}{Error taxonomy of the oracle gap. Each cell is \emph {prevalence}\,/\,\emph {share of total gap mass}. Full RefCOCO validation split, 10{,}834 expressions, oracle mIoU 0.8221 in both columns. Under-seg.\ = under-segmentation; over-seg.\ = over-segmentation}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Oracle-gap taxonomy on full RefCOCO val, at the unguided argmax operating point (left) and at the released HybridGL operating point (right). Solid bars: share of the total recoverable IoU. Hatched bars: prevalence. Wrong-instance selection dominates the gap mass at both operating points, although the guidance modules reduce its prevalence; under-segmentation, which granularity remedies target, carries a small and operating-point-dependent share.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:taxonomy}{{1}{3}{Oracle-gap taxonomy on full RefCOCO val, at the unguided argmax operating point (left) and at the released HybridGL operating point (right). Solid bars: share of the total recoverable IoU. Hatched bars: prevalence. Wrong-instance selection dominates the gap mass at both operating points, although the guidance modules reduce its prevalence; under-segmentation, which granularity remedies target, carries a small and operating-point-dependent share}{figure.1}{}}
